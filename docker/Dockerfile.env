FROM ghcr.io/joeoc2001/build-box:latest

RUN npm install -g @anthropic-ai/claude-code tsx @withone/cli

RUN apt-get update \
  && apt-get install -y --no-install-recommends tmux unzip woff2 \
  && rm -rf /var/lib/apt/lists/*

ARG TTYD_VERSION=1.7.7
RUN curl -fsSL -o /usr/local/bin/ttyd "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.x86_64" \
  && chmod +x /usr/local/bin/ttyd

ARG NERD_FONT_VERSION=3.2.1
ENV TTYD_FONT_FAMILY="JetBrainsMono Nerd Font Mono"
COPY docker/build-ttyd-index.sh docker/build-ttyd-index.mjs /opt/crc/ttyd/
RUN curl -fsSL -o /tmp/nerdfont.zip "https://github.com/ryanoasis/nerd-fonts/releases/download/v${NERD_FONT_VERSION}/JetBrainsMono.zip" \
  && unzip -o -j /tmp/nerdfont.zip "*NerdFontMono-Regular.ttf" -d /tmp/nerdfont \
  && FONT_TTF="$(ls /tmp/nerdfont/*NerdFontMono-Regular.ttf | head -1)" \
  && woff2_compress "$FONT_TTF" \
  && bash /opt/crc/ttyd/build-ttyd-index.sh "${FONT_TTF%.ttf}.woff2" /opt/crc/ttyd-index.html "$TTYD_FONT_FAMILY" \
  && rm -rf /tmp/nerdfont.zip /tmp/nerdfont /tmp/ttyd-index.html

RUN mkdir -p /root/.claude
COPY docker/claude-memory.md /root/.claude/CLAUDE.md
COPY claude/hooks /opt/crc/claude-hooks
COPY docker/tmux.conf /root/.tmux.conf

COPY packages/container-metadata-types /opt/crc/packages/container-metadata-types
COPY packages/container-metadata-server /opt/crc/packages/container-metadata-server

COPY docker/entrypoint.sh /entrypoint.sh
COPY docker/start-claude-session.sh /opt/crc/start-claude-session.sh
RUN chmod +x /entrypoint.sh /opt/crc/start-claude-session.sh

WORKDIR /workspace

ENTRYPOINT ["/entrypoint.sh"]
