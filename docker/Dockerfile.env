FROM ghcr.io/joeoc2001/build-box:latest

ARG CLAUDE_CODE_VERSION
ARG TSX_VERSION
ARG WITHONE_CLI_VERSION
RUN npm install -g \
  "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION:?}" \
  "tsx@${TSX_VERSION:?}" \
  "@withone/cli@${WITHONE_CLI_VERSION:?}"

ARG ANTIGRAVITY_CLI_URL
ARG ANTIGRAVITY_CLI_SHA512
RUN curl -fsSL -o /tmp/antigravity-cli.tar.gz "${ANTIGRAVITY_CLI_URL:?}" \
  && echo "${ANTIGRAVITY_CLI_SHA512:?}  /tmp/antigravity-cli.tar.gz" | sha512sum -c - \
  && tar -xzf /tmp/antigravity-cli.tar.gz -C /tmp antigravity \
  && install -m 0755 /tmp/antigravity /usr/local/bin/agy \
  && rm -f /tmp/antigravity-cli.tar.gz /tmp/antigravity
ENV AGY_CLI_DISABLE_AUTO_UPDATE=1

RUN apt-get update \
  && apt-get install -y --no-install-recommends tmux unzip woff2 \
  && rm -rf /var/lib/apt/lists/*

ARG TTYD_VERSION=1.7.7
RUN curl -fsSL -o /usr/local/bin/ttyd "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.x86_64" \
  && chmod +x /usr/local/bin/ttyd

ARG NERD_FONT_VERSION=3.2.1
ENV TTYD_FONT_FAMILY="JetBrainsMono Nerd Font Mono"
COPY docker/build-ttyd-index.sh docker/build-ttyd-index.mjs /opt/crc/ttyd/
RUN curl -fsSL -o /tmp/nerdfont.zip "https://github.com/ryanoasis/nerd-fonts/releases/download/v${NERD_FONT_VERSION}/JetBrainsMono.zip" \
  && unzip -o -j /tmp/nerdfont.zip "*NerdFontMono-Regular.ttf" -d /tmp/nerdfont \
  && FONT_TTF="$(ls /tmp/nerdfont/*NerdFontMono-Regular.ttf | head -1)" \
  && woff2_compress "$FONT_TTF" \
  && bash /opt/crc/ttyd/build-ttyd-index.sh "${FONT_TTF%.ttf}.woff2" /opt/crc/ttyd-index.html "$TTYD_FONT_FAMILY" \
  && rm -rf /tmp/nerdfont.zip /tmp/nerdfont /tmp/ttyd-index.html

RUN mkdir -p /root/.claude /root/.gemini/config /root/.gemini/antigravity-cli/cache
COPY docker/agent-memory.md /root/.claude/CLAUDE.md
COPY docker/agent-memory.md /root/.gemini/GEMINI.md
COPY agent-hooks/hooks /opt/crc/hooks
COPY docker/tmux.conf /root/.tmux.conf

COPY docker/no-agent-summary.js /opt/crc/no-agent-summary.js
ENV BUN_OPTIONS=--preload=/opt/crc/no-agent-summary.js

COPY packages/container-metadata-types /opt/crc/packages/container-metadata-types
COPY packages/container-metadata-server /opt/crc/packages/container-metadata-server

COPY docker/entrypoint.sh /entrypoint.sh
COPY docker/start-agent-session.sh /opt/crc/start-agent-session.sh
RUN chmod +x /entrypoint.sh /opt/crc/start-agent-session.sh

WORKDIR /workspace

ENTRYPOINT ["/entrypoint.sh"]
