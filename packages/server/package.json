{
  "name": "@crc/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/forge/*.test.ts src/tasks/*.test.ts"
  },
  "dependencies": {
    "@crc/container-metadata-types": "*",
    "@crc/shared": "*",
    "dockerode": "^4.0.4",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.5",
    "tar-stream": "^3.1.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.34",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/tar-stream": "^3.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
