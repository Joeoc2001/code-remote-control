{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": ["Bash", "Read", "Edit", "Write", "Glob", "Grep", "WebFetch", "WebSearch"]
  },
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node /opt/crc/claude-hooks/task-description.js" }] },
      { "hooks": [{ "type": "command", "command": "node /opt/crc/claude-hooks/instance-status.js working" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node /opt/crc/claude-hooks/git-hygiene.js", "timeout": 1230 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node /opt/crc/claude-hooks/instance-status.js finished" }] }
    ]
  }
}
